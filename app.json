{
  "expo": {
    "name": "Aoser",
    "slug": "aoser",
    "version": "1.0.8",
    "scheme": "com.aoser.app",
    "orientation": "portrait",
    "icon": "./assets/aoser_logo_ios.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/aoser_logo_no_bg_blue.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aoser.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Aoser to save QR codes to your photo library",
        "NSCameraUsageDescription": "Aoser needs access to your camera to take photos for your profile and to capture images of services you offer as a freelancer.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.534310388147-ie1fa8js9n91smba52idrpns8hjme379"
            ]
          }
        ]
      },
      "buildNumber": "12"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/aoser_logo_and2.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aoser.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/aoser_logo_no_bg_blue.png"
    },
    "extra": {
      "eas": {
        "projectId": "d60f7004-fd5e-42fa-ab00-fdf08bfc6a94"
      },
      "adiRegistrationSnippet": "CRY7QPUH7BWGKAAAAAAAAAAAAA"
    },
    "owner": "aosers",
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-video",
      "expo-web-browser",
      "expo-notifications",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aoser to access your photos to upload profile and service images.",
          "cameraPermission": "Aoser needs camera access to take photos for your profile and services."
        }
      ],
      "./plugins/withAdiRegistrationToken",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/perf",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBCrashlytics",
              "RNFBPerf"
            ]
          }
        }
      ]
    ]
  }
}