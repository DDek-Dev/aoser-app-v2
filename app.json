{
  "expo": {
    "name": "aoser-app",
    "slug": "aoser-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aoser_logo_no_bg.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/aoser_logo_no_bg_blue.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Aceer to save QR codes to your photo library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/aoser_logo_blue_bg.jpg",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aoser.aoser",
      "googleServicesFile": "./google-services.json",
            "permissions": ["WRITE_EXTERNAL_STORAGE", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/aoser_logo_blue_bg.jpg"
    },
    "extra": {
      "eas": {
        "projectId": "4e2864c6-db81-4c60-b273-8161e6b88246"
      }
    },
    "owner": "aoser-app",
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-video",
      "expo-web-browser",
      "expo-notifications",
      "expo-dev-client",
      "expo-image-picker"
    ]
  }
}