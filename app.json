{
  "expo": {
    "name": "Aoser",
    "slug": "aoser",
    "version": "1.0.0",
    "scheme": "com.aoser.app",
    "orientation": "portrait",
    "icon": "./assets/aoser_logo_and2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/aoser_logo_no_bg_blue.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aoser.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Aoser to save QR codes to your photo library",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [ 
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.534310388147-ie1fa8js9n91smba52idrpns8hjme379"
            ]
          }
        ]
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/aoser_logo_and2.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aoser.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/aoser_logo_no_bg_blue.png"
    },
    "extra": {
      "eas": {
        "projectId": "d60f7004-fd5e-42fa-ab00-fdf08bfc6a94"
      }
    },
    "owner": "aosers",
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-video",
      "expo-web-browser",
      "expo-notifications",
      "expo-dev-client",
      "expo-image-picker"
    ]
  }
}